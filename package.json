{
  "name": "cc-diff",
  "displayName": "CC Diff",
  "description": "Show file diffs after Claude Code conversations with Accept/Deny controls",
  "version": "1.0.0",
  "publisher": "cc-diff",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "cc-diff.setupHooks",
        "title": "安装 Hook 脚本",
        "category": "CC Diff"
      },
      {
        "command": "cc-diff.acceptAllFileEditor",
        "title": "Accept All",
        "icon": "$(check-all)",
        "category": "CC Diff"
      },
      {
        "command": "cc-diff.denyAllFileEditor",
        "title": "Deny All",
        "icon": "$(close-all)",
        "category": "CC Diff"
      },
      {
        "command": "cc-diff.prevHunk",
        "title": "Previous Hunk",
        "icon": "$(arrow-up)",
        "category": "CC Diff"
      },
      {
        "command": "cc-diff.nextHunk",
        "title": "Next Hunk",
        "icon": "$(arrow-down)",
        "category": "CC Diff"
      },
      {
        "command": "cc-diff.toggleDiffMode",
        "title": "Toggle Diff Mode",
        "icon": "$(split-horizontal)",
        "category": "CC Diff"
      },
      {
        "command": "cc-diff.openCurrentFile",
        "title": "Open File",
        "icon": "$(go-to-file)",
        "category": "CC Diff"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "cc-diff.toggleDiffMode",
          "when": "activeWebviewPanelId == cc-diff.monacoDiff",
          "group": "navigation@1"
        },
        {
          "command": "cc-diff.openCurrentFile",
          "when": "activeWebviewPanelId == cc-diff.monacoDiff",
          "group": "navigation@2"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "cc-diff-sidebar",
          "title": "CC Diff",
          "icon": "$(diff)"
        }
      ]
    },
    "views": {
      "cc-diff-sidebar": [
        {
          "type": "webview",
          "id": "cc-diff.view",
          "name": "Changes"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "compile": "tsc -p ./",
    "copy-webview": "node scripts/copy-webview.js",
    "build": "npm run compile && npm run copy-webview",
    "watch": "tsc -watch -p ./",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.0.0",
    "monaco-editor": "^0.45.0",
    "typescript": "^5.3.0"
  }
}
